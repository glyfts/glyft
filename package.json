{
  "name": "glyft",
  "version": "0.1.0",
  "description": "GPU-first, config-driven WebGL2 framework for tile-based 2D games",
  "type": "module",
  "main": "dist/src/index.js",
  "module": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./helpers": {
      "types": "./dist/src/helpers/index.d.ts",
      "import": "./dist/src/helpers/index.js"
    },
    "./adapters/wyrt": {
      "types": "./dist/src/adapters/wyrt.d.ts",
      "import": "./dist/src/adapters/wyrt.js"
    },
    "./adapters/websocket": {
      "types": "./dist/src/adapters/websocket.d.ts",
      "import": "./dist/src/adapters/websocket.js"
    },
    "./addons": {
      "types": "./dist/addons/index.d.ts",
      "import": "./dist/addons/index.js"
    },
    "./addons/projectiles": {
      "types": "./dist/addons/projectiles.d.ts",
      "import": "./dist/addons/projectiles.js"
    },
    "./addons/ai": {
      "types": "./dist/addons/ai.d.ts",
      "import": "./dist/addons/ai.js"
    },
    "./addons/death": {
      "types": "./dist/addons/death.d.ts",
      "import": "./dist/addons/death.js"
    },
    "./addons/rooms": {
      "types": "./dist/addons/rooms.d.ts",
      "import": "./dist/addons/rooms.js"
    },
    "./addons/dialogue": {
      "types": "./dist/addons/dialogue.d.ts",
      "import": "./dist/addons/dialogue.js"
    },
    "./addons/hud": {
      "types": "./dist/addons/hud.d.ts",
      "import": "./dist/addons/hud.js"
    }
  },
  "files": [
    "dist",
    "src",
    "addons"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:iife": "vite build --config vite.config.iife.ts",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "keywords": [
    "webgl",
    "webgl2",
    "game",
    "engine",
    "tilemap",
    "sprite",
    "2d",
    "gpu",
    "gamedev",
    "pixel-art",
    "retro"
  ],
  "author": "Glyft",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glyfts/glyft.git"
  },
  "homepage": "https://glyft.dev",
  "bugs": {
    "url": "https://github.com/glyfts/glyft/issues"
  },
  "devDependencies": {
    "canvas": "^3.2.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.0"
  }
}
