{
  "name": "glyft",
  "version": "0.1.0",
  "description": "GPU-first, config-driven WebGL2 framework for tile-based 2D games",
  "type": "module",
  "main": "dist/glyft.js",
  "module": "dist/glyft.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/glyft.js"
    },
    "./helpers": {
      "types": "./dist/helpers/index.d.ts",
      "import": "./dist/helpers/index.js"
    },
    "./adapters/wyrt": {
      "types": "./dist/adapters/wyrt.d.ts",
      "import": "./dist/adapters/wyrt.js"
    },
    "./adapters/websocket": {
      "types": "./dist/adapters/websocket.d.ts",
      "import": "./dist/adapters/websocket.js"
    },
    "./addons": {
      "types": "./dist/addons/index.d.ts",
      "import": "./dist/addons/index.js"
    },
    "./addons/projectiles": {
      "types": "./dist/addons/projectiles.d.ts",
      "import": "./dist/addons/projectiles.js"
    },
    "./addons/ai": {
      "types": "./dist/addons/ai.d.ts",
      "import": "./dist/addons/ai.js"
    },
    "./addons/death": {
      "types": "./dist/addons/death.d.ts",
      "import": "./dist/addons/death.js"
    },
    "./addons/rooms": {
      "types": "./dist/addons/rooms.d.ts",
      "import": "./dist/addons/rooms.js"
    },
    "./addons/dialogue": {
      "types": "./dist/addons/dialogue.d.ts",
      "import": "./dist/addons/dialogue.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "keywords": [
    "webgl",
    "webgl2",
    "game",
    "engine",
    "tilemap",
    "sprite",
    "2d",
    "gpu"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.0"
  }
}
